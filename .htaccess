<IfModule mod_rewrite.c>
RewriteEngine On

# ── Force HTTPS — redirect all HTTP to HTTPS ──
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# PWA Manifest & Service Worker routing
RewriteRule ^manifest\.json$ frontend/manifest.json [L]
RewriteRule ^sw\.js$ frontend/sw.js [L]
RewriteRule ^icon-192\.png$ frontend/icon-192.png [L]
RewriteRule ^icon-512\.png$ frontend/icon-512.png [L]

# Direct meeting links support
RewriteRule ^meeting\.html$ frontend/meeting.html [L]

# Route JS & CSS to frontend assets
RewriteRule ^js/(.*)$ frontend/js/$1 [L]
RewriteRule ^css/(.*)$ frontend/css/$1 [L]

# Route all /api/ requests to our PHP proxy
RewriteRule ^api/(.*)$ api.php [L,QSA]

# Proxy WebSocket requests to Node.js backend
# RewriteRule ^socket\.io/(.*)$ http://127.0.0.1:5000/socket.io/$1 [P,L]

# Serve uploaded files from backend
RewriteRule ^uploads/(.*)$ backend/uploads/$1 [L]
</IfModule>

# ── Security & PWA Headers ──
<IfModule mod_headers.c>
    # Prevent browser from showing "Not Secure" warning
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # PWA Service Worker & Manifest freshness + full root scope permission
    <FilesMatch "(sw\.js|manifest\.json)">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Service-Worker-Allowed "/"
    </FilesMatch>
</IfModule>

# Increase PHP timeout for deploy scripts
<IfModule mod_php.c>
php_value max_execution_time 300
</IfModule>
